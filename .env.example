# Copy to .env and edit. `.env` is gitignored and must never be committed.
#
# Everything here has a safe default, and the two that matter fail closed: an instance that sets
# none of this serves the console, accepts no ingestion, and has no live model arm.

# The database. The default points at the docker-compose service on a port no other project uses.
PAG_DATABASE_URL=postgresql+psycopg://parts:change_me_locally@127.0.0.1:15440/parts_answer_gate

# Read-only unless explicitly disabled. Leave this true for anything public: rebuilding an index is
# not something an anonymous visitor does.
PAG_READ_ONLY=true

# No default, deliberately. The abstractive answerer RAISES when this is unset rather than returning
# a stub — an arm that degraded quietly would look identical to one that ran and found nothing, and
# the evaluation would report a topology it never called. No cost or latency figure is published for
# any live arm in this build, because none has ever run.
PAG_LLM_API_KEY=

# Shown in the console header so a reader knows which instance they are looking at.
PAG_ENVIRONMENT=local

# Where the generated corpus, the built evidence and the embedding model cache live.
PAG_CORPUS_DIR=data/generated
PAG_ARTIFACTS_DIR=artifacts
PAG_EMBEDDING_CACHE=.fastembed_cache
